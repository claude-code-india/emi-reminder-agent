# Copy to .env and fill in. Never commit .env.

# Sarvam API key (from the Sarvam dashboard). Only needed if you trigger
# Sarvam calls/APIs from scripts; the local backend runs without it.
SARVAM_API_KEY=

# Port for the Customer/Payment API
PORT=3000

# Shared secret the Sarvam agent sends as the `x-api-key` header on every tool call.
# Leave empty to disable auth for local testing.
TOOL_API_KEY=

# ── Razorpay webhooks (POST /webhooks/razorpay) ─────────────────────
# Secret set on the webhook in Razorpay Dashboard → Settings → Webhooks.
# Used to verify X-Razorpay-Signature (HMAC-SHA256 of the raw body).
# Leave empty ONLY for local testing: unsigned webhooks are then accepted with a warning.
RAZORPAY_WEBHOOK_SECRET=

# ── Sarvam outbound calls (npm run dial) ────────────────────────────
# Instant Outbound API: POST https://apps.sarvam.ai/api/outbounds/v1/orgs/{org}/workspaces/{ws}/outbounds
# Auth uses SARVAM_API_KEY above, sent as the X-API-Key header. If SARVAM_API_KEY is empty the dialer runs in dry-run mode.
# Organization and workspace IDs (Sarvam dashboard → Settings, or the dashboard URL).
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
# Published agent's App ID and the version you validated in the Playground.
SARVAM_AGENT_ID=
SARVAM_APP_VERSION=1
# Telephony connection + E.164 caller number (Deploy → Phone Numbers).
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=
# Optional: full endpoint override (e.g. a mock/staging URL). Normally leave empty.
SARVAM_CALL_API_URL=
# Optional: HTTPS URL that receives Sarvam's call-outcome webhook (status, duration, transcript).
SARVAM_CALL_WEBHOOK_URL=
