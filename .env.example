# Copy to .env and fill in. Never commit .env.

# Sarvam API key (from the Sarvam dashboard). Only needed if you trigger
# Sarvam calls/APIs from scripts; the local backend runs without it.
SARVAM_API_KEY=

# Port for the Customer/Payment API
PORT=3000

# Shared secret the Sarvam agent sends as the `x-api-key` header on every tool call.
# Leave empty to disable auth for local testing.
TOOL_API_KEY=
